# Clean slate - unset all ANTHROPIC_* vars first
unset ANTHROPIC_MODEL
unset ANTHROPIC_SMALL_FAST_MODEL_AWS_REGION
unset ANTHROPIC_DEFAULT_HAIKU_MODEL
unset ANTHROPIC_DEFAULT_SONNET_MODEL
unset ANTHROPIC_DEFAULT_OPUS_MODEL

# Enable Bedrock integration
export CLAUDE_CODE_USE_BEDROCK=1
export AWS_REGION=__BEDROCK_REGION__

# Override the region for the small/fast model (Haiku)
export ANTHROPIC_SMALL_FAST_MODEL_AWS_REGION=__BEDROCK_REGION__

# Default model on startup - Choose Sonnet or Opus from your tribe's ARNs
export ANTHROPIC_MODEL='__BEDROCK_DEFAULT_MODEL_ARN__'

# Default models - enables /model command switching and /context command
# Use these to switch between models on-the-fly with /model haiku, /model sonnet, /model opus
export ANTHROPIC_DEFAULT_HAIKU_MODEL='__BEDROCK_HAIKU_ARN__'
export ANTHROPIC_DEFAULT_SONNET_MODEL='__BEDROCK_SONNET_ARN__[1m]'
export ANTHROPIC_DEFAULT_OPUS_MODEL='__BEDROCK_OPUS_ARN__'

# Opus fallback chain consumed by the claude() wrapper's --fallback-model flag.
# Fires only on 5xx/overload of the primary (not 429). Tried in order.
export BEDROCK_OPUS_FALLBACK_ARNS='__BEDROCK_OPUS_FALLBACK_ARNS__'

# Flicker-free alt-screen rendering with virtualised scrollback
export CLAUDE_CODE_NO_FLICKER=1

# Enable tool discovery across MCP servers
export ENABLE_TOOL_SEARCH=true

# Declare supported capabilities for Bedrock inference profiles
# (Claude Code cannot auto-detect from ARNs; without these, /effort and thinking are silently disabled)
export ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES='effort,max_effort,thinking,adaptive_thinking,interleaved_thinking'
export ANTHROPIC_CUSTOM_MODEL_OPTION_SUPPORTED_CAPABILITIES='effort,max_effort,thinking,adaptive_thinking,interleaved_thinking'
export ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES='effort,thinking,adaptive_thinking,interleaved_thinking,long_context'
export ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES='effort,thinking,adaptive_thinking'

# Extend prompt cache TTL from 5 minutes to 1 hour (cache hits cost ~90% less)
export ENABLE_PROMPT_CACHING_1H=1

# Strip AWS/Anthropic credentials from Bash tool, hooks, and MCP subprocesses
export CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=1

# Auto-update Claude Code on session start (npm/Homebrew/etc., based on installation method)
export CLAUDE_CODE_PACKAGE_MANAGER_AUTO_UPDATE=1

# Opt into the deterministic multi-agent Workflow tool (gated; also requires server-side
# tengu_workflows_enabled flag, so may be a no-op on Bedrock until enabled there)
export CLAUDE_CODE_WORKFLOWS=1

# Enable Auto mode on Bedrock/Vertex/Foundry (Opus 4.7 and 4.8 only). Added in Claude Code
# v2.1.158 to close the parity gap with first-party. Auto routes effort dynamically per turn.
export CLAUDE_CODE_ENABLE_AUTO_MODE=1

# Enable the (currently undocumented) LSP tool surface. Required by the roslyn-lsp plugin
# (and any other LSP plugin) to actually expose findReferences/goToDefinition/etc to Claude.
export ENABLE_LSP_TOOL=1
