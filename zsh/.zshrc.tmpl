eval "$(thefuck --alias)"

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Starship draws the prompt, so Oh My Zsh loads no theme.
ZSH_THEME=""

# zsh-syntax-highlighting wraps the widgets loaded before it, so it comes last, except for history-substring-search,
# which must follow it.
plugins=(
  git
  zsh-autosuggestions
  z
  aws
  web-search
  extract
  sudo
  colored-man-pages
  dotnet
  terraform
  fzf
  zsh-syntax-highlighting
  history-substring-search
)

# Docker CLI completions, ahead of Oh My Zsh so its compinit picks them up.
fpath=($HOME/.docker/completions $fpath)

source $ZSH/oh-my-zsh.sh

# Fixterms/CSI u key bindings for Ghostty (bare shell, no tmux).
# Ghostty sends CSI u or xterm-modifyOtherKeys sequences for modified keys;
# zsh has no native CSI u support so we bind them explicitly.
# Inside tmux, extended-keys handles the translation instead.
_zle_insert_newline() { LBUFFER+=$'\n'; }
zle -N _zle_insert_newline
bindkey '\e[27;2;13~'  _zle_insert_newline  # Shift+Enter  → newline (continuation)
bindkey '\e[27;5;13~'  accept-line          # Ctrl+Enter   → submit
bindkey '\e[27;2;127~' backward-delete-char # Shift+Backspace
bindkey '\e[27;5;127~' backward-delete-char # Ctrl+Backspace

# Bitwarden SSH agent (desktop app must be running and unlocked). Kept out of Claude Code's environment: not exported
# into its shell snapshot, and stripped from the launch by claude-launch-env. ssh needs no SSH_AUTH_SOCK there, since
# ~/.ssh/config names the socket (IdentityAgent), and git's ssh-sign reads it from that.
if [[ -z $CLAUDECODE ]]; then
    export SSH_AUTH_SOCK="__SSH_AGENT_SOCK__"
fi

# Bitwarden CLI serve daemon (LaunchAgent-managed; see bitwarden package)
export BW_SERVE_URL="http://localhost:8087"
[[ -r "$HOME/.config/zsh/bw-unlock.zsh" ]] && source "$HOME/.config/zsh/bw-unlock.zsh"

export DOTNET_ROOT=/usr/local/share/dotnet
export PATH=$PATH:$DOTNET_ROOT/tools:$HOME/.dotnet/tools
# The NuGet PAT is exported for every shell, and so for GUI apps that import a login-shell environment (Rider, say).
# It is read from envchain at shell start; a locked keychain or a missing namespace is skipped silently.
if [[ -n "__NUGET_NAMESPACE__" ]]; then
    () {
        local line
        for line in ${(f)"$(envchain __NUGET_NAMESPACE__ env 2>/dev/null)"}; do
            [[ $line =~ '^[A-Za-z_][A-Za-z0-9_]*_NUGET_PAT=' ]] && export "$line"
        done
    }
fi
export AWS_REGION='__AWS_REGION__'
export PATH="$HOMEBREW_PREFIX/opt/llvm/bin:$PATH"

export PATH=/opt/homebrew/opt/python@3.14/libexec/bin:$PATH

# Claude Code's native installer puts its launcher here.
export PATH="$HOME/.local/bin:$PATH"

# Added by LocalStack installer
[[ -r "$HOME/.localstack/localstack_setup.sh" ]] && source "$HOME/.localstack/localstack_setup.sh"

# Classify claude's arguments into REPLY: bare (a subcommand, help or version: run as given), direct (a print or
# background session: run here with the wrapper's flags) or tmux (an interactive session).
claude-arg-mode() {
    local subcommands=(
        agents attach auth auto-mode doctor gateway import install kill logs mcp plugin plugins purge respawn rm
        setup-token stop ultrareview update upgrade
    )
    REPLY=tmux
    if (( ${subcommands[(Ie)$1]} )); then
        REPLY=bare
        return
    fi
    local arg
    for arg in "$@"; do
        case $arg in
            -h|--help|-v|--version) REPLY=bare; return ;;
            -p|--print|--bg|--background) REPLY=direct ;;
        esac
    done
}

# Set reply to the variables a personal session must not inherit: every name ~/.claudeenv exports, AWS_PROFILE and
# CLAUDE_CODE_USE_BEDROCK (any of these may have been exported by hand).
claude-work-vars() {
    reply=()
    local line re='^[[:space:]]*export[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)='
    if [[ -r $HOME/.claudeenv ]]; then
        while IFS= read -r line; do
            if [[ $line =~ $re ]]; then
                reply+=("$match[1]")
            fi
        done < "$HOME/.claudeenv"
    fi
    reply+=(AWS_PROFILE CLAUDE_CODE_USE_BEDROCK)
    reply=("${(@u)reply}")
}

# Set reply to the env arguments for the launch line both wrappers build: SSH_AUTH_SOCK unset (see its export above),
# then the provider-neutral flags Claude Code reads before settings load.
claude-launch-env() {
    reply=(
        -u SSH_AUTH_SOCK
        CLAUDE_CODE_NO_FLICKER=1
        CLAUDE_CODE_WORKFLOWS=1
    )
}

# Set REPLY to the command that moves a tmux pane into this shell's directory; refuse (status 1) when that directory
# no longer exists. tmux 3.8 has started panes in the server's own start directory even when given -c, and once that
# directory is deleted every new pane fails, so the pane changes directory itself.
claude-pane-cd() {
    if [[ $PWD != /* || ! -d $PWD ]]; then
        echo "claude: the current directory no longer exists; cd somewhere else first" >&2
        return 1
    fi
    REPLY="cd ${(q)PWD} || { sleep 5; exit 1; }; "
}

# Run interactive Claude Code sessions inside tmux for detach/reattach support.
# Claude sets the terminal title via --name or /name; a tmux hook
# syncs the pane title to the tmux session name automatically.
# Session-level hooks survive renames because tmux binds them to
# the session object, not the name.
# The Bedrock environment (~/.claudeenv) and the work settings layer reach only the claude process: no interactive
# shell holds them.
claude() {
    # Claude Code's shell snapshot carries this function into its Bash tool, where the session's own environment
    # decides.
    if [[ -n $CLAUDECODE ]]; then
        command claude "$@"
        return
    fi
    local mode
    claude-arg-mode "$@"
    mode=$REPLY
    # Fail closed: a ~/.claudeenv that does not load Bedrock would let claude fall through to the first-party account
    # with work traffic.
    local envfail="claude: ~/.claudeenv failed to load or lacks CLAUDE_CODE_USE_BEDROCK=1; run ~/dotfiles/hydrate.sh"
    if [[ $mode == bare ]]; then
        if [[ -r $HOME/.claudeenv ]]; then
            (
                source "$HOME/.claudeenv" && [[ $CLAUDE_CODE_USE_BEDROCK == 1 ]] || { echo "$envfail" >&2; exit 1 }
                command claude "$@"
            )
        else
            echo "claude: ~/.claudeenv is missing (run ~/dotfiles/hydrate.sh); running without Bedrock" >&2
            command claude "$@"
        fi
        return
    fi

    local work_settings=$HOME/.claude/settings.work.json
    if [[ ! -r $HOME/.claudeenv ]]; then
        echo "claude: ~/.claudeenv is missing; run ~/dotfiles/hydrate.sh" >&2
        return 1
    fi
    if [[ ! -r $work_settings ]]; then
        echo "claude: $work_settings is missing; run ~/.claude/scripts/apply-settings.sh" >&2
        return 1
    fi
    local pane_cd
    claude-pane-cd || return 1
    pane_cd=$REPLY

    # Pre-flight: ensure SSO token is valid before launching.
    # Avoids the AWS SDK hang on expired tokens (Claude Code issue #28032).
    if [[ -x "$HOME/.claude/scripts/aws-sso-preflight.sh" ]]; then
        "$HOME/.claude/scripts/aws-sso-preflight.sh"
    fi

    local -a launch
    claude-launch-env
    launch=(env "${reply[@]}" claude)

    # An empty fallback must yield no word, or --fallback-model takes the next flag as its value.
    if [[ $mode == direct ]]; then
        (
            source "$HOME/.claudeenv" && [[ $CLAUDE_CODE_USE_BEDROCK == 1 ]] || { echo "$envfail" >&2; exit 1 }
            "${launch[@]}" --model opus ${BEDROCK_OPUS_FALLBACK_ARNS:+--fallback-model=$BEDROCK_OPUS_FALLBACK_ARNS} \
                --settings "$work_settings" --exclude-dynamic-system-prompt-sections "$@"
        )
        return
    fi

    # Slug is c-<abbrev>-<4hex>, derived from the cwd basename + a random
    # 4-hex suffix. session-init.sh reads the tmux name back and uses it as
    # the Claude sessionTitle, so tmux name and Claude title match exactly.
    local session
    session=$("$HOME/.claude/scripts/derive-claude-slug.sh")
    # 16-bit collision space — vanishingly rare, but re-roll if hit.
    while tmux has-session -t "$session" 2>/dev/null; do
        session=$("$HOME/.claude/scripts/derive-claude-slug.sh")
    done
    # One command string: given several arguments, tmux runs them directly without a shell. The fallback expands in
    # the pane, after ~/.claudeenv. The environment check is POSIX, since tmux's default-shell may be sh; the sleep
    # keeps the pane open to show it.
    local pane_env_check="{ . ~/.claudeenv && [ \"\$CLAUDE_CODE_USE_BEDROCK\" = 1 ]; } || "
    pane_env_check+="{ printf '%s\\n' ${(qq)envfail} >&2; sleep 5; exit 1; }"
    tmux new-session -s "$session" \
        "$pane_cd$pane_env_check; exec ${(j: :)${(@q)launch}} --model opus \${BEDROCK_OPUS_FALLBACK_ARNS:+--fallback-model=\$BEDROCK_OPUS_FALLBACK_ARNS} --settings ${(q)work_settings} --exclude-dynamic-system-prompt-sections ${(j: :)${(q)@}}"
}
# Launch Claude Code with a personal Pro subscription (no Bedrock).
# Strips every variable ~/.claudeenv exports, plus AWS_PROFILE and CLAUDE_CODE_USE_BEDROCK, so Claude falls back to
# OAuth login; the shell's NuGet PAT is left alone. Wraps in tmux like claude() but skips the SSO preflight.
claude-personal() {
    # Claude Code's shell snapshot carries this function into its Bash tool, where the session's own environment
    # decides.
    if [[ -n $CLAUDECODE ]]; then
        command claude "$@"
        return
    fi
    # `env … claude` already runs the binary (env never sees functions); Linux has no /usr/bin/command.
    local -a work_vars strip early
    local name
    claude-work-vars
    work_vars=("${reply[@]}")
    for name in "${work_vars[@]}"; do
        strip+=(-u "$name")
    done
    claude-launch-env
    early=("${reply[@]}")
    # The work Datadog MCP must not feed work observability data into a personal-account session.
    local settings='{"disabledMcpjsonServers":["datadog"]}'

    # Outside tmux, still strip the work environment so auth/doctor/-p/etc. target the personal account.
    local mode
    claude-arg-mode "$@"
    mode=$REPLY
    if [[ $mode == bare ]]; then
        env "${strip[@]}" claude "$@"
        return
    fi
    local pane_cd
    claude-pane-cd || return 1
    pane_cd=$REPLY

    # Pre-authenticate outside tmux so the browser OAuth redirect works.
    if ! env "${strip[@]}" claude auth status &>/dev/null; then
        echo "Personal account authentication required..."
        env "${strip[@]}" claude auth login || return 1
    fi

    if [[ $mode == direct ]]; then
        env "${strip[@]}" "${early[@]}" claude --model opus --settings "$settings" \
            --exclude-dynamic-system-prompt-sections "$@"
        return
    fi

    # Personal-account variant uses prefix `p` so it's distinguishable from
    # the work `c-` sessions in tmux.
    local session
    session=$("$HOME/.claude/scripts/derive-claude-slug.sh" "" p)
    while tmux has-session -t "$session" 2>/dev/null; do
        session=$("$HOME/.claude/scripts/derive-claude-slug.sh" "" p)
    done
    # One command string: given several arguments, tmux runs them directly without a shell. The pane inherits the tmux
    # server's environment, not this shell's, so it strips again.
    tmux new-session -s "$session" \
        "${pane_cd}tmux set-option status-style 'bg=#eda6c2,fg=black'; unset ${(j: :)${(@q)work_vars}}; exec env ${(j: :)${(@q)early}} claude --model opus --settings ${(q)settings} --exclude-dynamic-system-prompt-sections ${(j: :)${(q)@}}"
}

alias cat='bat --paging=never'
alias ls='eza --group-directories-first'
alias ll='eza -lh --group-directories-first --git'
alias la='eza -lah --group-directories-first --git'
alias lt='eza --tree --level=2'
# Upgrade all Homebrew packages, then trigger Gatekeeper approval for any
# quarantined startup/login cask apps that were actually upgraded. macOS
# Sequoia blocks programmatic quarantine removal; opening from Terminal
# presents an approvable dialogue instead of Finder's dead-end prompt.
bup() {
    local -A startup_casks=(
        [docker-desktop]=Docker
        [bitwarden]=Bitwarden
        [hammerspoon]=Hammerspoon
        [karabiner-elements]="Karabiner-Elements"
        [monitorcontrol]=MonitorControl
    )

    local -a outdated
    outdated=("${(@f)$(brew outdated --cask --greedy-latest --quiet 2>/dev/null)}")

    HOMEBREW_ACCEPT_EULA=Y brew upgrade --greedy-latest

    local cask app_name app_path
    for cask in "${outdated[@]}"; do
        app_name="${startup_casks[$cask]}"
        [[ -n "$app_name" ]] || continue
        app_path="/Applications/${app_name}.app"
        if [[ -d "$app_path" ]] && xattr -p com.apple.quarantine "$app_path" &>/dev/null; then
            echo "Opening quarantined startup app for approval: ${app_name}"
            open "$app_path"
        fi
    done

    # Global npm packages (playwright-cli, language servers) sit outside brew.
    # Install each outdated one at its latest version rather than `npm update -g`,
    # which treats globals as caret ranges and so can stop short of a new major.
    # --parseable's fourth field is "<name>@<latest>".
    local -a npm_latest
    npm_latest=("${(@f)$(npm outdated --global --parseable 2>/dev/null | cut -d: -f4)}")
    npm_latest=("${(@)npm_latest:#}")
    if (( ${#npm_latest} )); then
        echo "Updating global npm packages: ${npm_latest[*]}"
        npm install --global "${npm_latest[@]}"
    fi

    # --greedy-latest re-downloads whole cask DMGs on every run and never prunes
    # them, so the cache grows by hundreds of MB per upgrade without this.
    brew cleanup --prune=all
}
# List tmux sessions as "slug  <@topic>". @topic is the guessed session headline
# a Claude Code session-topic Stop hook can set (— when unset). column aligns the
# two fields.
tls() {
    tmux list-sessions -F '#{session_name}|#{?@topic,#{@topic},—}' 2>/dev/null | column -t -s '|'
}
alias tk='tmux kill-session -a'
ta() {
    tmux attach -t "$@"
}
_ta() {
    local -a sessions
    sessions=(${(f)"$(tmux list-sessions -F '#S' 2>/dev/null)"})
    compadd -a sessions
}
compdef _ta ta

# fzf configuration (shell integration handled by OMZ fzf plugin)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'

# Starship prompt
eval "$(starship init zsh)"