# Keys are served by Bitwarden SSH agent. IdentityAgent names its socket for every host, so ssh works where
# SSH_AUTH_SOCK is not set: .zshrc keeps it out of Claude Code's Bash tool.
# Add host-specific overrides below as needed.

Host github.com
    IdentityAgent __SSH_AGENT_SOCK__

Host *
    IdentityAgent __SSH_AGENT_SOCK__
    AddKeysToAgent yes
    UseKeychain yes
    ServerAliveInterval 60
    ServerAliveCountMax 3

# Per-machine personal hosts (not in version control). OpenSSH silently skips
# this include if the file doesn't exist.
Include ~/.ssh/config.local
