# Dotfiles Template — Configuration
# Copy to config.env and fill in your values.
# Run ./hydrate.sh to generate config files from templates.

# --- git ---
GIT_USER_NAME=             # quote if it contains spaces, e.g. "Jane Doe"
GIT_USER_EMAIL=
GIT_SIGNING_KEY=           # quote it, e.g. "ssh-ed25519 AAAA..."

# --- aws ---
SSO_START_URL=             # e.g. https://myorg.awsapps.com/start
SSO_REGION=eu-west-1
SSO_SESSION_NAME=sso       # name of the [sso-session] block (any org alias works)
# Add account profiles as needed. Format: PROFILE_NAME|ACCOUNT_ID|ROLE_NAME|REGION
# Used by hydrate.sh to generate ~/.aws/config. The REGION field is
# optional — leave it empty (trailing pipe) to inherit from the session,
# e.g. "profile-name|123456789012|RoleName|"
AWS_PROFILES=(
    # "profile-name|123456789012|RoleName|eu-west-1"
)

# --- docker ---
ECR_REGISTRY=              # e.g. 123456789012.dkr.ecr.eu-west-1.amazonaws.com

# --- zsh ---
SSH_AGENT_SOCK=            # e.g. ~/.bitwarden-ssh-agent.sock
NUGET_NAMESPACE=           # envchain namespace for NuGet PAT (leave empty to skip)
JETBRAINS_TOOLBOX_PATH=    # quote it and use $HOME, e.g. "$HOME/Library/Application Support/JetBrains/Toolbox/scripts"
AWS_REGION=eu-west-1       # default AWS region exported in .zshrc

# --- zsh (claude code bedrock) ---
BEDROCK_REGION=
BEDROCK_DEFAULT_MODEL_ARN=
BEDROCK_HAIKU_ARN=
BEDROCK_SONNET_ARN=
BEDROCK_OPUS_ARN=

# --- mcp ---
DATADOG_MCP_SCRIPT=        # absolute path to datadog-mcp.sh wrapper

# --- datadog ---
DATADOG_SITE=              # e.g. datadoghq.com, datadoghq.eu

# --- hammerspoon ---
WHISPER_PROMPT=            # domain-specific terms for whisper (see docs/whisper-prompt-technique.md)

# --- bootstrap ---
DOTFILES_REPO=             # e.g. git@github.com:youruser/dotfiles.git
CLAUDE_SETTINGS_REPO=      # e.g. git@github.com:youruser/claude-settings.git
DOTNET_TOOLS=()            # e.g. ("amazon.lambda.tools" "amazon.lambda.testtool")
