[user]
	name = __GIT_USER_NAME__
	email = __GIT_USER_EMAIL__
	signingkey = __GIT_SIGNING_KEY__
[core]
	editor = code
	filemode = false
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
	line-numbers = true
	hyperlinks = true
[diff]
	colorMoved = default
[merge]
	conflictstyle = zdiff3
[color]
	ui = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[pull]
	rebase = false
[filter "strongbox"]
	clean = strongbox -clean %f
	smudge = strongbox -smudge %f
	required = true
[diff "strongbox"]
	textconv = strongbox -diff
[merge "strongbox"]
	driver = strongbox -merge-file %O -merge-file %A -merge-file %B -merge-file %L -merge-file %P -merge-file %S -merge-file %X -merge-file %Y
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
# Per-machine personal overrides (not in version control). git silently skips
# this include if the file doesn't exist. Use it for things like
# `[includeIf "gitdir:..."] path = ~/.gitconfig-work` work-email routing.
[include]
	path = ~/.gitconfig.local
