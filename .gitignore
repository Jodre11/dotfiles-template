# Private config (tracked in private repo, not in template)
config.env

# Machine-local pattern lists the git hooks read; they name what must not be published, so they are never committed
/.githooks/identity-patterns.local
/.githooks/always-patterns.local

# Generated files (produced by hydrate.sh from .tmpl templates)
aws/.aws/config
docker/.docker/config.json
git/.gitconfig
mcp/.mcp.json
scripts/datadog-mcp.sh
ssh/.ssh/config
zsh/.claudeenv
zsh/.zprofile
zsh/.zshrc
# A temp file hydrate.sh left behind (it removes them on every exit it sees; SIGKILL or power loss can leave one).
.*.hydrate.*

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
*.swp
*.swo
*~

# Stow
.stow-local-ignore
# …but the bitwarden package needs its own tracked ignore (skips *.tmpl strays)
!bitwarden/.stow-local-ignore

# Hydrated bw serve plist (source of truth is the .tmpl)
bitwarden/Library/LaunchAgents/com.user.bw-serve.plist

# Playwright MCP
.playwright-cli/

# Firefox bookmark backups (generated at runtime)
firefox/.config/firefox/backups/
